# System Health Monitor Configuration
# Copy to config.env and customize

# Alert thresholds (percent)
CPU_THRESHOLD=80
MEM_THRESHOLD=85
DISK_THRESHOLD=90

# Load average threshold (absolute, not percent)
LOAD_THRESHOLD=4.0

# Log file path
LOG_FILE=/var/log/system-health.log

# Slack webhook URL (leave empty to disable)
SLACK_WEBHOOK=

# Alert email address (leave empty to disable, requires 'mail' command)
ALERT_EMAIL=

# Override hostname in alerts
# HOSTNAME=my-server-01
